# 依赖
node_modules/

# 构建产物
dist/
out/
*.vsix

# registry 自签证书 (含私钥, 不入库; 需要时本地 openssl 重新生成)
registry/certs/

# 环境配置 (仅 .env.example 提交到 git, 其它 gitignore)
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production

# opencode 运行工作区 (dev:opencode 在此目录启动, 运行时数据/会话)
# 内部是用户文件 (PDF/代码等), 不纳入版本控制
/assistant/workspace/*


# 临时
.cache/
*.log

# 编辑器/系统
.DS_Store
.idea/
.vscode/
.playwright-mcp/
.playwright-screenshots/
.userData/
.workspace/

# webpack 编译缓存 (filesystem cache, 可随时重建)
.webpack-cache/
